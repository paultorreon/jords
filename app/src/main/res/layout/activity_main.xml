<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Yellow logo, top right -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Logo"
        android:src="@drawable/ic_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="88dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Text input 1 -->
        <EditText
            android:id="@+id/etField1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoHandwritingEnabled="false"
            android:background="@drawable/bg_input_line"
            android:hint="Name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="12dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8A8A"
            android:textSize="24sp" />

        <!-- Text input 2 -->
        <EditText
            android:id="@+id/etField2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autoHandwritingEnabled="false"
            android:background="@drawable/bg_input_line"
            android:hint="Message"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="12dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8A8A"
            android:textSize="24sp" />

        <!-- Submit button -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_red"
            android:elevation="0dp"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            android:text="submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="normal" />

        <!-- Saved entries list -->
        <ListView
            android:id="@+id/listEntries"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_list_box"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:padding="8dp" />

        <!-- View button -->
        <Button
            android:id="@+id/btnView"
            android:layout_width="250dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_red"
            android:elevation="0dp"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            android:text="VIEW"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="normal" />

    </LinearLayout>
</FrameLayout>
